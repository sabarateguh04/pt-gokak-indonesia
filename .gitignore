# Dependencies
node_modules/

# File upload (foto bukti pengerjaan tiket) - jangan di-commit, cuma data runtime
uploads/bukti/*
!uploads/bukti/.gitkeep

# Environment variables (jangan pernah ke-push, isinya credential DB)
.env
.env.local

# ⚠️ LICENSING -- private key JANGAN PERNAH ke-push kemanapun (termasuk
# private repo sekalipun) -- itu satu-satunya yang bisa nandatangan
# license baru. license.lic juga di-ignore karena isinya token khusus
# PER CUSTOMER (bukan source code, beda-beda tiap instalasi) -- lihat
# notesubscribe.md. config/license-public.pem SENGAJA GAK di-ignore,
# itu aman buat di-ship (cuma bisa verifikasi, bukan bikin token baru).
licensing-tools/keys/
license.lic

# Registry partner/customer lokal (licensing-tools/register-partner.js)
# -- isinya nama & catatan customer (data bisnis, bukan source code),
# SENGAJA cuma ada di laptop vendor yang generate license, gak perlu &
# gak boleh ke-commit. "Terdaftar" artinya ADA DI FILE INI, di laptop
# vendor -- bukan di git.
licensing-tools/partners.json

# Paket Docker PER MITRA (dibuat otomatis lewat menu "Kelola Mitra" /
# licensing-tools/lib/issue-license.js) -- isinya RAHASIA PER CUSTOMER
# (JWT_SECRET unik, token lisensi) di dalam docker/<id_mitra>/*, jangan
# pernah ke-commit. Folder docker/ sendiri (kosong) TETAP di-track lewat
# .gitkeep biar strukturnya kebawa di clone baru.
docker/*
!docker/.gitkeep

# Hasil build obfuscated (scripts/build-obfuscate.js) -- artefak build,
# di-generate ulang tiap kali mau bikin image Docker, gak perlu ikut git.
dist/

# Data runtime servis internal vendor (vendor-license-service/) -- catatan
# check-in customer, bukan source code, beda-beda tiap deployment servis
# itu. Folder ini sendiri idealnya dipindah ke repo terpisah begitu mau
# beneran dihosting -- lihat notesubscribe.md bagian 10-C.
vendor-license-service/checkins.json

# Logs
*.log
npm-debug.log*

# OS files
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
