# Contoh reverse proxy pakai Caddy -- INI YANG BIKIN AKSES KE APLIKASI
# LEWAT HTTPS (terenkripsi) BENERAN, bukan cuma http://ip:3010 polos.
# Caddy otomatis ngurus sertifikat TLS (Let's Encrypt) sendiri, gak
# perlu setup manual kayak certbot/openssl.
#
# Cara pakai (di server customer, TERPISAH dari container app):
#   1. Install Caddy: https://caddyserver.com/docs/install
#   2. Salin file ini jadi `Caddyfile` (tanpa .example), ganti
#      `app.namadomain-customer.com` ke domain BENERAN yang sudah
#      diarahkan (DNS A record) ke IP server ini.
#   3. Pastikan port 80 & 443 kebuka di firewall server (Caddy butuh
#      80 buat validasi Let's Encrypt, 443 buat HTTPS beneran).
#   4. Jalankan: caddy run --config Caddyfile
#      (atau install sebagai service: caddy start / systemd, lihat
#      dokumentasi Caddy buat platform masing-masing)
#
# Setelah ini aktif, akses aplikasi lewat https://app.namadomain-customer.com
# -- BUKAN lagi http://ip-server:3010 langsung. Port 3010 di
# docker-compose.yml boleh tetap kebuka ke localhost aja (gak perlu
# expose ke internet), Caddy yang terusin traffic-nya ke situ.
#
# ⚠️ PENTING soal apa yang HTTPS lindungi & apa yang ENGGAK:
#   - HTTPS enkripsi data SELAMA PERJALANAN dari browser user ke server
#     ini -- orang yang nyadap jaringan di tengah (WiFi publik, ISP,
#     dst) gak bisa baca isi request/response.
#   - HTTPS TIDAK nyembunyiin apapun dari orang yang buka DevTools/
#     Inspect Element DI BROWSER MEREKA SENDIRI -- itu memang cara
#     kerja browser (harus bisa baca konten buat nampilinnya), berlaku
#     sama di SEMUA situs termasuk bank sekalipun. Yang ngebantu buat
#     itu justru obfuscation kode JS (lihat scripts/build-obfuscate.js).

app.namadomain-customer.com {
	reverse_proxy localhost:3010

	# Header keamanan tambahan di level proxy (pelengkap helmet() yang
	# udah aktif di app-nya sendiri, lihat server.js)
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}

	# Log akses (opsional, berguna buat audit/troubleshooting)
	log {
		output file /var/log/caddy/pt-gokak-access.log
	}
}
