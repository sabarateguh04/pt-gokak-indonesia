PORT=3010

DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=pt_gokak_indonesia
DB_PORT=3306

# Ganti dengan string acak yang panjang & rahasia di production
JWT_SECRET=pt-gokak-indonesia-dev-secret-CHANGE-ME

# Titik tengah default kamera peta dashboard. Area geofence buat KPI
# kehadiran diatur terpisah lewat halaman admin "Area Pabrik" (tabel
# pt_kapuk_area) -- titik ini cuma nentuin peta awalnya nunjuk ke mana.
#
# SAAT INI dialihkan ke lokasi kantor buat masa development (Ruko
# Pesona View, Blok C7), BUKAN lokasi pabrik asli. Ganti ke koordinat
# pabrik kapan pun development pindah ke sana.
FACTORY_LAT=-6.380064
FACTORY_LNG=106.8408239

# Lisensi (lihat notesubscribe.md) -- app baca license key dari FILE
# `license.lic` di root project (bikin filenya, isi 1 baris token yang
# dikasih vendor -- lihat licensing-tools/generate-license.js). Env
# LICENSE_KEY di bawah ini cuma FALLBACK kalau license.lic gak ada
# (praktis buat dev/testing cepat).
# LICENSE_KEY=
