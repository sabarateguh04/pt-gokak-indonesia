PORT=3010

DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=pt_gokak_indonesia
DB_PORT=3306

# Ganti dengan string acak yang panjang & rahasia di production
JWT_SECRET=pt-gokak-indonesia-dev-secret-CHANGE-ME

# Titik tengah default kamera peta dashboard. Area geofence buat KPI
# kehadiran diatur terpisah lewat halaman admin "Area Pabrik" (tabel
# pt_kapuk_area) -- titik ini cuma nentuin peta awalnya nunjuk ke mana.
#
# SAAT INI dialihkan ke lokasi kantor buat masa development (Ruko
# Pesona View, Blok C7), BUKAN lokasi pabrik asli. Ganti ke koordinat
# pabrik kapan pun development pindah ke sana.
FACTORY_LAT=-6.380064
FACTORY_LNG=106.8408239

# Lisensi (lihat notesubscribe.md) -- app baca license key dari FILE
# `license.lic` di root project (bikin filenya, isi 1 baris token yang
# dikasih vendor -- lihat licensing-tools/generate-license.js). Env
# LICENSE_KEY di bawah ini cuma FALLBACK kalau license.lic gak ada
# (praktis buat dev/testing cepat).
# LICENSE_KEY=

# ⚠️ ID_MITRA -- kode unik "ID mitra/customer" buat instalasi INI SAJA.
# DIISI VENDOR pas nyiapin paket buat customer tertentu (BUKAN sesuatu
# yang customer pilih/isi sendiri) -- HARUS SAMA PERSIS (case-sensitive)
# dengan --id yang dipakai vendor pas generate token lewat
# licensing-tools/generate-license.js. Kalau beda/kosong padahal token-nya
# punya id_mitra, token DITOLAK walau tanda tangannya sah -- ini nyegah
# license.lic 1 customer asal ditempel ke instalasi customer lain.
# Kosongkan (default) buat dev/testing biasa -- pengecekan ini OPT-IN,
# gak aktif kalau baris ini gak diisi.
# ID_MITRA=PT-GOKAK

# Prefix nama tabel di database instalasi INI (misal `djalu_depok_`
# buat tabel `djalu_depok_admins`, `djalu_depok_teknisi`, dst) --
# DIISI VENDOR (biasanya otomatis lewat menu Kelola Mitra, sama kayak
# ID_MITRA di atas). Kosongkan (default) = pakai `pt_kapuk_` seperti
# instalasi lama sebelum fitur ini ada -- 100% backward compatible,
# gak ada perubahan buat instalasi yang udah jalan. JANGAN ubah manual
# di instalasi yang SUDAH PUNYA DATA -- nama tabel yang udah ada di
# database gak ikut berubah sendiri, cuma query barunya yang bakal
# nyasar ke nama yang salah.
# TABLE_PREFIX=djalu_depok_

# Alamat webhook internal vendor buat notifikasi tiap ada request
# lisensi baru (POST /api/license/request) -- OPSIONAL, kalau kosong
# request tetap kesimpen ke DB (pt_kapuk_license_requests), cuma gak
# ada notifikasi realtime ke vendor.
# VENDOR_REQUEST_WEBHOOK_URL=

# Email support vendor yang ditampilin di halaman /license-locked &
# menu Lisensi admin, biar customer tau kemana kontak kalau lisensi
# bermasalah.
# VENDOR_SUPPORT_EMAIL=support@vendor-anda.com

# URL Vendor License Service (folder vendor-license-service/, HARUS
# dihosting terpisah dari server customer -- lihat notesubscribe.md
# Fase 2-C). OPSIONAL: kalau kosong, phone-home mati total & app jalan
# normal cuma pakai deteksi jam mundur LOKAL. Kalau diisi & servisnya
# beneran hidup, app bakal check-in tiap 12 jam buat nutupin celah
# "hapus baris jangkar jam + mundurin jam sekaligus".
# LICENSE_SERVICE_URL=

# ⚠️ VENDOR_MASTER_MODE -- ngaktifin menu "Kelola Mitra" (/admin/mitra,
# /api/mitra/*) buat daftar mitra/customer baru, generate token
# lisensi, & scaffold paket docker/<id_mitra>/ otomatis. CUMA buat
# instalasi vendor SENDIRI (biasanya jalan lewat `npm run dev`/`npm
# start` langsung dari source, BUKAN dari Docker image). JANGAN PERNAH
# set true di .env yang dikirim ke customer manapun -- walaupun
# kelupaan ke-set, halaman & route-nya SENGAJA gak pernah ikut ke
# build customer sama sekali (lihat scripts/build-obfuscate.js), jadi
# ini cuma lapisan proteksi TAMBAHAN, bukan satu-satunya.
# VENDOR_MASTER_MODE=true

# Daftar origin (comma-separated) yang boleh akses API ini lewat CORS
# dari domain LAIN -- KOSONGKAN (default) kecuali beneran ada frontend
# terpisah yang perlu cross-origin fetch. App ini single-origin
# (frontend & API diserve dari server yang sama), jadi CORS gak
# dibutuhkan buat pemakaian normal.
# ALLOWED_ORIGINS=https://app.contoh.com,https://admin.contoh.com
